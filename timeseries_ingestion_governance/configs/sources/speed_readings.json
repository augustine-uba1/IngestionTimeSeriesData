{
  "version": 1,
  "applied_schema": "configs/sources/schemas/reading_schema.json",
  "name": "speed_readings",
  "description": "Speed readings in hertz.",
  "source_system": "intelliam_iot",
  "domain": "iot",
  "file_format": "csv",
  "landing_path": "abfss://<container>@<sa>.dfs.core.windows.net/iot/landing/speed_readings/*.csv",
  "raw_table": "iot.raw.speed_readings_raw",
  "bronze_table": "iot.bronze.speed_readings",
  "primary_key": ["UID"],
  "natural_key": ["sensor_id", "timestamp"],
  "csv_options": {
    "header": true,
    "delimiter": ",",
    "encoding": "utf-8",
    "multiLine": false
  },
  "parsing": {
    "timestamp_format": "dd/MM/yyyy HH:mm",
    "timezone": "UTC"
  },
  "schema_evolution": {
    "autoloader_schema_evolution_mode": "addNewColumns",
    "rescued_data_column": "_rescued_data",
    "on_unexpected_columns": "capture"
  },
  "governance": {
    "table_tags": {
      "layer": "raw/bronze",
      "entity": "reading",
      "measurement": "speed",
      "contains_pii": "no",
      "sensitivity": "internal",
      "retention": "365d"
    }
  },
  "columns": [
    { "name": "UID", "type": "string", "nullable": false, "tags": { "classification": "metadata", "role": "record_id" } },
    { "name": "sensor_id", "type": "string", "nullable": false, "tags": { "classification": "metadata", "role": "sensor_id" } },
    { "name": "timestamp", "type": "timestamp", "source_type": "string", "nullable": false, "parse": { "from_format": "dd/MM/yyyy HH:mm" }, "tags": { "classification": "telemetry", "role": "event_time" } },
    {
      "name": "hertz",
      "type": "double",
      "nullable": false,
      "tags": { "classification": "telemetry", "role": "speed", "unit": "Hz" },
      "quality": [
        { "rule": "between", "expr": { "min": 0.0, "max": 500.0 } }
      ]
    }
  ]
}
